# Claude Free API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Model Selection (free options)
# Options: claude-3-5-haiku, claude-3-haiku (cheapest & fastest)
AI_MODEL=claude-3-5-haiku

# Optional: Fallback models if primary fails
FALLBACK_MODEL=claude-3-haiku
USE_FALLBACK=true

# Rate limiting (to stay within free tier)
MAX_TOKENS=1000
TEMPERATURE=0.7
